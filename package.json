{
  "name": "empathy-agent-edgeone",
  "version": "1.0.0",
  "description": "可本地运行的情感陪伴助手，支持 OpenAI 兼容 API",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.cjs",
    "dev": "npm run build && npm start",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:browser": "npm run build && playwright test",
    "check": "npm test && npm run test:browser",
    "security:check": "node scripts/check-secrets.cjs",
    "model:check": "npm run build && node --env-file-if-exists=.env scripts/check-model.cjs"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
