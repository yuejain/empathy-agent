# auto: 未配置时显示演示模式；配置任何模型项后必须填写完整。live: 必须配置。
APP_MODE=auto
# 兼容 OpenAI 的服务；密钥只保存在本机，禁止放入 src 或提交 Git。
AI_GATEWAY_API_KEY=
# 填服务商给出的完整基础路径，如 https://api.example.com/v1
# 支持 /v1、/api/v3、自定义路径或完整 /chat/completions 地址。
AI_GATEWAY_BASE_URL=
# 填服务商提供的模型 ID
AI_GATEWAY_MODEL=
# 可选，默认不发送 thinking 字段。仅支持此字段的服务（如 MiMo）可填写 disabled/enabled。
AI_GATEWAY_THINKING=
# 默认 max_tokens；MiMo 推荐 max_completion_tokens。
AI_GATEWAY_TOKEN_PARAM=max_tokens
AI_TIMEOUT_MS=45000
PORT=3000
# 默认在 .data/sessions.json 保存最近 10 轮和独立的跨会话长期记忆档案。
# 设置 false 则仅保存在内存；不用于生产多用户部署。
SESSION_PERSISTENCE=true
# After local training and Start-LocalML.ps1, enable local emotion RAG for cloud replies.
# LOCAL_ML_URL=http://127.0.0.1:3001
