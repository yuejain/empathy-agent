# 统一换行符：仓库内一律使用 LF，避免 Windows/Linux 差异
* text=auto eol=lf

# 明确文本类型
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制文件不做换行转换
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.bin        binary
*.pt         binary
*.pth        binary
*.onnx       binary
*.safetensors binary

# git 语言统计中排除
package-lock.json linguist-generated=true
